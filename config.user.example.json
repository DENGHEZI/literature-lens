{
  "note": "复制为 config.user.json 后，填入用户自备 API。providers 是整体覆盖：请保留需要的全部 provider。密钥推荐使用环境变量而非明文。",
  "active_provider": "translation-api",
  "providers": [
    {
      "id": "translation-api",
      "name": "用户翻译 API",
      "protocol": "openai",
      "base_url": "https://your-api.example/v1",
      "api_key": "${LITERATURE_LENS_TRANSLATE_KEY}",
      "model": "your-translation-model",
      "enabled": true,
      "weight": 10,
      "roles": ["chat", "translate"],
      "ctx": 128000,
      "max_output": 8192,
      "supports_json": true
    },
    {
      "id": "reasoning-api",
      "name": "用户推理 / 导图 API",
      "protocol": "openai",
      "base_url": "https://your-api.example/v1",
      "api_key": "${LITERATURE_LENS_REASONING_KEY}",
      "model": "your-reasoning-model",
      "enabled": true,
      "weight": 20,
      "roles": ["analyze", "mindmap"],
      "ctx": 128000,
      "max_output": 8192,
      "supports_json": true
    }
  ]
}
